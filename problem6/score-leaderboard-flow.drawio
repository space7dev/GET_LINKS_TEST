  <diagram id="execution-flow" name="Execution Flow">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Secure Live Leaderboard — Execution Flow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="560" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="trust-label" value="Untrusted client" style="swimlane;html=1;startSize=30;horizontal=1;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="230" height="690" as="geometry"/>
        </mxCell>
        <mxCell id="trusted-label" value="Trusted backend boundary" style="swimlane;html=1;startSize=30;horizontal=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="1240" height="690" as="geometry"/>
        </mxCell>
        <mxCell id="browser-action" value="1. User completes action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="155" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="action-service" value="2. Action subsystem&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Validates completion and calculates points&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="145" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="completion-db" value="3. Create one-time completion&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;completion_id + owner + points + expiry&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="625" y="135" width="220" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="post-score" value="4. POST /v1/score-events&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Bearer token + completion_id only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="315" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="score-api" value="5. Score API&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Authenticate • rate-limit • validate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="310" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="transaction" value="6. Atomic PostgreSQL transaction&lt;br&gt;&lt;br&gt;① Lock and verify completion owner/state/expiry&lt;br&gt;② Increment user_scores&lt;br&gt;③ Append score_ledger&lt;br&gt;④ Mark completion consumed&lt;br&gt;⑤ Insert outbox event&lt;br&gt;&lt;br&gt;&lt;b&gt;Commit all or roll back all&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="625" y="275" width="280" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="response" value="7. Return authoritative result&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Retry returns the same result; never awards twice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="345" y="490" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="browser-result" value="Score updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="500" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="outbox" value="8. Outbox publisher&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Reliably emits ScoreChanged.v1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="965" y="310" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="projector" value="9. Leaderboard projector&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Deduplicates and computes deterministic top 10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1245" y="310" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="10. Redis projection&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Cached snapshot + monotonically increasing version&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1245" y="485" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="sse" value="11. Realtime gateway (SSE)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Pushes complete, versioned top-10 snapshot&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="965" y="490" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="live-browser" value="12. Browser applies only&lt;br&gt;newer snapshot version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="655" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="failure-note" value="Redis/SSE failure never loses a score. PostgreSQL remains authoritative and the outbox is replayed after recovery." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="625" y="635" width="550" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="browser-action" target="action-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="action-service" target="completion-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="completion_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="completion-db" target="post-score"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="255"/><mxPoint x="280" y="255"/><mxPoint x="280" y="355"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="post-score" target="score-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="score-api" target="transaction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="after commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="transaction" target="response"><mxGeometry relative="1" as="geometry"/></mxCell>
